# Copy this file to ".env" and fill in the values. ".env" is gitignored.
# When adding a variable, also add it to the schema in "src/env.js".

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# http://localhost:3000 locally, https://fin.devshub.xyz in production
BETTER_AUTH_URL="http://localhost:3000"
# Set to "true" only when running scripts/create-user.ts
# AUTH_ALLOW_SIGNUP="true"

# Guards /api/cron/daily. Generate with: openssl rand -base64 24
CRON_SECRET=""

# Drizzle (Neon pooled connection string)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Assistant — at least one provider key is required.
# Order to try: the first configured provider answers, the next is the fallback.
ASSISTANT_PROVIDERS="anthropic,gemini"

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Google AI Studio
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Development only: scripted replies, no Gemini calls
# ASSISTANT_MOCK="1"
